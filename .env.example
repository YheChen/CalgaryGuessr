# Google Maps JavaScript API key. Used by the guess map, the Street View
# panorama, and the client-side StreetViewService lookup that turns a stored
# coordinate into a playable round. Without it /game cannot load a round.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase web config. The game reads the `verifiedLocations` collection from
# Firestore; it never writes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
